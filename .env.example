# =============================================================================
# Toygres Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string for Duroxide workflow state and CMS metadata.
# Used by: toygres-server, toygres-orchestrations (CMS activities)
# Schemas created: toygres_duroxide (workflow state), toygres_cms (app metadata)
DATABASE_URL=postgresql://user:password@host:5432/database

# -----------------------------------------------------------------------------
# Azure Kubernetes Service (required)
# -----------------------------------------------------------------------------
# The AKS cluster where PostgreSQL instances are deployed.
# Used by: toygres-server (config validation, status display)
AKS_CLUSTER_NAME=your-aks-cluster
AKS_RESOURCE_GROUP=your-resource-group

# -----------------------------------------------------------------------------
# Azure Service Principal (required for AKS deployment)
# -----------------------------------------------------------------------------
# Service principal credentials for Azure CLI authentication during deployment.
# Used by: deploy/deploy-to-aks.sh (az login --service-principal)
# Also passed to K8s secrets for workload identity.
# Create via: az ad sp create-for-rbac --name "toygres-sp" --role contributor
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id

# -----------------------------------------------------------------------------
# Admin Credentials (required)
# -----------------------------------------------------------------------------
# Login credentials for the Toygres web UI.
# Used by: toygres-server (authentication at /login)
TOYGRES_ADMIN_USERNAME=admin
TOYGRES_ADMIN_PASSWORD=your-secure-password

# -----------------------------------------------------------------------------
# Azure Blob Storage (required for backup/restore)
# -----------------------------------------------------------------------------
# Storage account for PostgreSQL image backups.
# Used by: create_image orchestration (backup jobs), restore flows
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_CONTAINER=toygres-images

# -----------------------------------------------------------------------------
# Azure Container Registry (required for runtime images)
# -----------------------------------------------------------------------------
# The ACR where PostgreSQL runtime images are stored.
# Used by: push-postgres-container-image-to-toygres prompt, image registration
TOYGRES_ACR_NAME=your-acr-name

# -----------------------------------------------------------------------------
# Toygres API (optional)
# -----------------------------------------------------------------------------
# The URL where the Toygres API is running.
# Defaults to http://localhost:8080 if not set.
# Used by: CLI tools, automation scripts, prompts
TOYGRES_API_URL=http://localhost:8080

